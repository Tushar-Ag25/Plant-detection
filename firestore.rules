rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read, write, and manage their own documents under users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users full access to any subcollections under their own user document (e.g., scans, history)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
